<section class="calculator-section" id="cotizador">
  <div class="section-title">
    <span class="eyebrow">Arma tu pedido</span>
    <h2>Arma tu Pedido y te Cotizamos</h2>
    <p>Elige tus productos y envíanos tu solicitud. Te cotizamos sin compromiso. Mínimo de <strong>100 piezas</strong> por evento.</p>
  </div>

  <div class="calculator-card">
    <div class="corner-kernels" aria-hidden="true"></div>
    <div class="form-success" id="form-success" role="status">
      <i class="fa-solid fa-circle-check"></i> ¡Solicitud enviada! Revisaremos tu información y te contactaremos por WhatsApp o correo con tu cotización.
    </div>

    <div class="progress-wrapper">
      <div class="progress-header"><span>Tu pedido va así:</span><span id="pieces-count">0 / 100 piezas</span></div>
      <div class="progress-bar-container"><div class="progress-bar-fill" id="progress-fill"></div></div>
      <div class="status-text" id="status-message" aria-live="polite"><i class="fa-solid fa-seedling"></i> Empieza a agregar productos para armar tu pedido (mínimo 100 piezas).</div>
    </div>

    <!-- Las respuestas se envían por correo a wrodzar@gmail.com vía FormSubmit.
         Primer envío desde la página publicada = correo de activación a ese buzón. -->
    <form action="https://formsubmit.co/wrodzar@gmail.com" method="POST" id="event-form" accept-charset="UTF-8">
      <input type="hidden" name="_subject" value="Nueva solicitud de evento - Elotes Patria">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" id="next-url" value="">
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">

      <h3 class="step-title"><i class="fa-solid fa-user"></i> 1. Datos del Evento</h3>
      <div class="form-grid-2">
        <div class="form-group"><label for="nombre">Nombre Completo / Empresa *</label><input type="text" id="nombre" name="Nombre_Cliente" required placeholder="Ej. Sofía Mendoza"></div>
        <div class="form-group"><label for="telefono">WhatsApp / Teléfono de Contacto *</label><input type="tel" id="telefono" name="Telefono" required placeholder="33 1234 5678"></div>
      </div>
      <div class="form-grid-2">
        <div class="form-group"><label for="email">Correo Electrónico *</label><input type="email" id="email" name="email" required placeholder="correo@ejemplo.com"></div>
        <div class="form-group"><label for="tipo_evento">Tipo de Evento *</label>
          <select id="tipo_evento" name="Tipo_Evento" required>
            <option value="">Selecciona una opción</option>
            <option value="Boda">Boda</option>
            <option value="Fiesta Privada / Cumpleaños">Fiesta Privada / Cumpleaños</option>
            <option value="Evento Corporativo">Evento Corporativo</option>
            <option value="Evento Gubernamental">Evento Gubernamental</option>
            <option value="Otro">Otro</option>
          </select>
        </div>
      </div>
      <div class="form-grid-2">
        <div class="form-group"><label for="fecha">Fecha del Evento *</label><input type="date" id="fecha" name="Fecha_Evento" required></div>
        <div class="form-group"><label for="ubicacion">Ubicación / Municipio del Evento *</label><input type="text" id="ubicacion" name="Ubicacion" required placeholder="Ej. Zapopan, Jal."></div>
      </div>

      <hr class="divider">

      <h3 class="step-title" id="menu"><i class="fa-solid fa-utensils"></i> 2. Selección del Menú</h3>
      <div class="products-grid" id="products-grid"></div>

      <h3 class="step-title"><i class="fa-solid fa-clipboard-list"></i> 3. Requerimientos Especiales</h3>
      <div class="form-group">
        <label for="notas">Instrucciones o requerimientos especiales del lugar:</label>
        <textarea id="notas" name="Notas_Especiales" rows="3" placeholder="Ej. El evento es en un jardín en planta baja, requerimos montaje 1 hora antes."></textarea>
      </div>

      <input type="hidden" name="Total_Piezas_Acumuladas" id="hidden_total_pieces" value="0">
      <button type="submit" id="btn-submit" class="btn-submit" disabled><i class="fa-solid fa-paper-plane"></i> Enviar mi Solicitud</button>
      <p class="submit-note">Sin pagos ni compromiso. Te contactamos con tu cotización.</p>
    </form>
  </div>
</section>

