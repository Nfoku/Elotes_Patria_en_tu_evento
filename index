:root{--primary-green:#1E4D2B;--primary-green-dark:#14351D;--secondary-gold:#F4B41A;--accent-orange:#E07B22;--accent-red:#C0392B;--bg-cream:#FDF8EE;--bg-card:#FFF;--text-dark:#1C2526;--text-muted:#5A6567;--border-color:#E2E8F0;--radius:14px;--shadow:0 10px 30px rgba(30,77,43,.10)}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg-cream);color:var(--text-dark);line-height:1.6;overflow-x:hidden}
h1,h2,h3,h4{font-family:'Outfit',sans-serif;font-weight:700}
img{max-width:100%}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--secondary-gold);outline-offset:2px}

/* HEADER */
header{background:var(--primary-green);color:#fff;position:sticky;top:0;z-index:1000;box-shadow:0 4px 15px rgba(0,0,0,.1)}
.nav-container{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding:.6rem 1.5rem;gap:1rem}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo img{height:52px;width:auto;display:block}
.nav-links{display:flex;gap:22px;align-items:center}
.nav-links a{color:#fff;text-decoration:none;font-weight:600;font-size:.95rem;transition:color .3s}
.nav-links a:hover{color:var(--secondary-gold)}
.btn{display:inline-block;border-radius:50px;font-weight:700;text-decoration:none;cursor:pointer;border:none;transition:transform .2s,background .3s;font-family:inherit}
.btn-gold{background:var(--secondary-gold);color:var(--primary-green-dark);padding:.6rem 1.2rem}
.btn-gold:hover{transform:translateY(-2px);background:#e0a312}
.btn-wa{background:#25D366;color:#0B3D1A;padding:.6rem 1.2rem}
.btn-wa:hover{transform:translateY(-2px);background:#1EBE5A}

/* HERO */
.hero{position:relative;background:radial-gradient(circle at 70% 30%,#2a6b3d,var(--primary-green) 55%,var(--primary-green-dark));color:#fff;overflow:hidden}
.hero-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:1rem;padding:3.5rem 1.5rem 3rem}
.hero-badge{display:inline-block;background:rgba(244,180,26,.18);border:1px solid var(--secondary-gold);color:var(--secondary-gold);padding:.4rem 1.2rem;border-radius:50px;font-size:.85rem;font-weight:700;margin-bottom:1.3rem;letter-spacing:.3px}
.hero h1{font-size:3rem;line-height:1.12;margin-bottom:1.1rem}
.hero h1 .accent{color:var(--secondary-gold)}
.hero p{font-size:1.2rem;opacity:.95;margin-bottom:1.8rem;max-width:34ch}
.hero-cta{display:flex;gap:.9rem;flex-wrap:wrap}
.hero-cta .btn{font-size:1.05rem;padding:.95rem 1.7rem}
.hero-photo{position:relative;display:flex;justify-content:center;align-items:center;min-height:360px}
.hero-photo img{width:100%;max-width:480px;filter:drop-shadow(0 22px 34px rgba(0,0,0,.45));transform:rotate(3deg)}
/* granos decorativos del logo */
.kernel{position:absolute;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffd34d,var(--secondary-gold) 70%);box-shadow:0 2px 4px rgba(0,0,0,.15);opacity:.9}
.hero .k1{width:24px;height:24px;top:40%;left:2%}
.hero .k2{width:16px;height:16px;top:82%;left:6%}
.hero .k3{width:20px;height:20px;top:10%;right:4%}
.hero .k4{width:13px;height:13px;top:90%;right:44%}
@media(max-width:860px){.hero .kernel{display:none}}

/* FRANJA DE CONFIANZA */
.trust{background:var(--secondary-gold);color:var(--primary-green-dark)}
.trust-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;padding:1rem 1.5rem;text-align:center}
.trust-item{display:flex;align-items:center;justify-content:center;gap:.55rem;font-weight:700;font-size:.95rem}
.trust-item i{font-size:1.15rem}

/* SECCIONES GENERALES */
.section{max-width:1100px;margin:4rem auto;padding:0 1.5rem}
.section-title{text-align:center;margin-bottom:2.3rem}
.section-title .eyebrow{display:inline-block;color:var(--accent-orange);font-weight:800;letter-spacing:1px;text-transform:uppercase;font-size:.85rem;margin-bottom:.4rem}
.section-title h2{font-size:2.1rem;color:var(--primary-green)}
.section-title p{color:var(--text-muted);max-width:52ch;margin:.6rem auto 0}

/* MENÚ ANTOJO */
.menu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.4rem}
.menu-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s}
.menu-card:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(30,77,43,.16)}
.menu-card-img{height:170px;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.menu-card-img.photo-amarillo{background:radial-gradient(circle at 50% 40%,#2a6b3d,var(--primary-green))}
.menu-card-img.photo-asado{background:radial-gradient(circle at 50% 40%,#2a6b3d,var(--primary-green))}
.menu-card-img img{height:150px;width:auto;object-fit:contain;filter:drop-shadow(0 10px 16px rgba(0,0,0,.35))}
.menu-card-img.icon{background:linear-gradient(135deg,#2a6b3d,var(--primary-green))}
.menu-card-img.icon i{font-size:3.2rem;color:var(--secondary-gold)}
.menu-card-body{padding:1.1rem 1.2rem 1.3rem}
.menu-card-body h4{font-size:1.15rem;color:var(--primary-green-dark);margin-bottom:.35rem}
.menu-card-body p{font-size:.9rem;color:var(--text-muted)}
.menu-cta{text-align:center;margin-top:2rem}

/* CÓMO FUNCIONA */
.how{background:#fff;border-top:1px solid var(--border-color);border-bottom:1px solid var(--border-color)}
.how-inner{max-width:1000px;margin:0 auto;padding:3.5rem 1.5rem}
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;margin-top:1rem}
.how-step{text-align:center;padding:1.4rem 1rem;background:var(--bg-cream);border-radius:var(--radius)}
.how-num{width:52px;height:52px;margin:0 auto .9rem;border-radius:50%;background:var(--primary-green);color:var(--secondary-gold);display:flex;align-items:center;justify-content:center;font-family:'Outfit';font-weight:800;font-size:1.4rem}
.how-step h4{color:var(--primary-green-dark);margin-bottom:.35rem;font-size:1.1rem}
.how-step p{font-size:.92rem;color:var(--text-muted)}

/* SUCURSALES */
.branches-bar{background:var(--bg-cream);padding:0 1.5rem}
.branches-container{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem}
.branch-card{display:flex;align-items:flex-start;gap:15px;background:#fff;padding:1.1rem 1.3rem;border-radius:var(--radius);border-left:4px solid var(--secondary-gold);box-shadow:var(--shadow)}
.branch-card i{font-size:1.5rem;color:var(--primary-green);margin-top:3px}
.branch-card p{font-size:.85rem;color:var(--text-muted)}

/* GALERÍA */
.gallery-section{max-width:1200px;margin:4rem auto 0;padding:0 1.5rem}
.gallery-wrap{position:relative}
.gallery-grid{display:flex;gap:1.2rem;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;padding:.3rem .2rem 1rem;scrollbar-width:thin;scrollbar-color:var(--primary-green) #E2E8F0}
.gallery-item{position:relative;display:block;flex:0 0 min(85%,420px);scroll-snap-align:start;aspect-ratio:4/3;overflow:hidden;border-radius:var(--radius);background:#E2E8F0;box-shadow:var(--shadow)}
.gallery-nav{position:absolute;top:calc(50% - 1rem);transform:translateY(-50%);z-index:2;width:44px;height:44px;border-radius:50%;border:none;background:rgba(255,255,255,.95);color:var(--primary-green);font-size:1.1rem;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.25);transition:opacity .2s,background .2s}
.gallery-nav:hover{background:var(--secondary-gold)}
.gallery-nav:disabled{opacity:0;pointer-events:none}
.gallery-nav.prev{left:-8px}
.gallery-nav.next{right:-8px}
@media(prefers-reduced-motion:reduce){.gallery-grid{scroll-behavior:auto}}
.gallery-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.gallery-item:hover img{transform:scale(1.05)}
.gallery-caption{position:absolute;left:0;right:0;bottom:0;padding:1.6rem 1rem .8rem;background:linear-gradient(transparent,rgba(20,53,29,.9));color:#fff;font-weight:600;font-size:.95rem}
.gallery-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;color:var(--text-muted);font-size:.9rem}
.gallery-placeholder i{font-size:2rem;color:var(--primary-green);opacity:.5}
.gallery-note{text-align:center;color:var(--text-muted);margin-top:1rem;font-size:.95rem}

/* COTIZADOR */
.calculator-section{max-width:1000px;margin:4rem auto;padding:0 1.5rem}
.calculator-card{position:relative;background:var(--bg-card);border-radius:var(--radius);box-shadow:var(--shadow);padding:2.5rem;border:1px solid var(--border-color);overflow:hidden}
.calculator-card .corner-kernels{position:absolute;top:-10px;right:-10px;width:120px;height:120px;opacity:.12;background:radial-gradient(circle at 30% 30%,var(--secondary-gold) 22%,transparent 24%) 0 0/26px 26px}
.form-success{display:none;background:#ECFDF3;border:1px solid var(--primary-green);color:var(--primary-green-dark);border-radius:var(--radius);padding:1.2rem 1.5rem;margin-bottom:1.5rem;font-weight:600}
.form-success.show{display:block}
.progress-wrapper{background:#F3FAF4;border-radius:var(--radius);padding:1.5rem;margin-bottom:2rem;border:2px dashed var(--secondary-gold);text-align:center}
.progress-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.8rem;font-weight:700;flex-wrap:wrap;gap:.3rem}
.progress-bar-container{width:100%;height:16px;background:#E2E8F0;border-radius:10px;overflow:hidden;margin-bottom:.5rem}
.progress-bar-fill{height:100%;width:0;background:linear-gradient(90deg,var(--secondary-gold),var(--primary-green));transition:width .3s ease-in-out}
.status-text{font-size:.95rem;font-weight:600;color:var(--primary-green)}
.status-text.ready{color:var(--primary-green)}
.form-group{margin-bottom:1.5rem}
.form-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
label{display:block;font-weight:600;margin-bottom:.5rem;font-size:.95rem}
input[type=text],input[type=email],input[type=tel],input[type=date],select,textarea{width:100%;padding:.8rem 1rem;border:1px solid #7C8A99;border-radius:8px;font-family:inherit;font-size:1rem;transition:border-color .3s}
input:focus,select:focus,textarea:focus{border-color:var(--primary-green)}
.step-title{margin-bottom:1rem;color:var(--primary-green)}
.divider{border:none;border-top:1px solid var(--border-color);margin:2rem 0}
.products-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.2rem;margin-bottom:2rem}
.product-item{background:#F8FAFC;border:1px solid var(--border-color);padding:1rem;border-radius:10px;display:flex;flex-direction:column;justify-content:space-between}
.product-info h4{font-size:1.05rem;color:var(--primary-green-dark);margin-bottom:.3rem}
.product-info p{font-size:.85rem;color:var(--text-muted);margin-bottom:.8rem}
.counter-control{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.btn-counter{width:40px;height:40px;border-radius:50%;border:2px solid var(--primary-green);background:#fff;color:var(--primary-green);font-weight:700;font-size:1.1rem;cursor:pointer;transition:all .2s}
.btn-counter:hover{background:var(--primary-green);color:#fff}
.step-hint{font-size:.8rem;color:var(--text-muted)}
.counter-input{width:60px!important;text-align:center;padding:.4rem!important;font-weight:700}
.btn-submit{width:100%;background:var(--primary-green);color:#fff;padding:1.2rem;border:none;border-radius:50px;font-size:1.2rem;font-weight:700;cursor:pointer;transition:all .3s;box-shadow:0 4px 15px rgba(30,77,43,.2)}
.btn-submit:disabled{background:#E2E8F0;color:#4B5563;cursor:not-allowed;box-shadow:none}
.btn-submit:not(:disabled):hover{background:var(--primary-green-dark);transform:translateY(-2px)}
.submit-note{text-align:center;font-size:.85rem;color:var(--text-muted);margin-top:.8rem}

/* FOOTER */
footer{background:var(--primary-green-dark);color:#fff;padding:3rem 1.5rem 1.5rem;margin-top:4rem}
.footer-container{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem;margin-bottom:2rem}
.footer-container img{height:70px;margin-bottom:1rem}
.footer-container a{color:var(--secondary-gold)}
.footer-bottom{text-align:center;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.1);font-size:.9rem;opacity:.8}

/* WHATSAPP FLOTANTE */
.wa-float{position:fixed;right:18px;bottom:18px;z-index:1100;width:58px;height:58px;border-radius:50%;background:#25D366;color:#0B3D1A;font-size:2rem;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 6px 18px rgba(0,0,0,.25);transition:transform .2s}
.wa-float:hover{transform:scale(1.08)}

@media(max-width:860px){
  .hero-inner{grid-template-columns:1fr;text-align:center}
  .hero p{margin-left:auto;margin-right:auto}
  .hero-cta{justify-content:center}
  .hero-photo{order:-1;min-height:260px}
  .hero-photo img{max-width:300px}
  .trust-inner{grid-template-columns:1fr 1fr;text-align:left}
  .how-grid{grid-template-columns:1fr}
}
@media(max-width:768px){.hero h1{font-size:2.2rem}.form-grid-2{grid-template-columns:1fr}.nav-links{display:none}.calculator-card{padding:1.5rem}}
</style>
</head>
