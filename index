  <div class="footer-container">
    <div>
      <img src="logo_actualizado.png" alt="Elotes Patria">
      <p>La experiencia artesanal de elotes y esquites para tus mejores momentos. Calidad gourmet, sabor tradicional e higiene garantizada.</p>
    </div>
    <div>
      <h4>Nuestras Sucursales</h4>
      <p>📍 Plaza Patria (frente a KFC)</p>
      <p>📍 Andador Basílica de Zapopan (Prol. 20 de Noviembre)</p>
    </div>
    <div>
      <h4>Contáctanos</h4>
      <p>💬 <a href="https://wa.me/523311130209" target="_blank" rel="noopener">WhatsApp: 33 1113 0209</a></p>
      <p>Lleva el antojo de siempre a tu evento.</p>
    </div>
  </div>
  <div class="footer-bottom"><p>&copy; 2026 Elotes Patria. Todos los derechos reservados. Zapopan, Jalisco.</p></div>
</footer>

<a href="https://wa.me/523311130209?text=Hola%2C%20quiero%20cotizar%20un%20evento%20con%20Elotes%20Patria" class="wa-float" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>

<script>
/* ===== PRODUCTOS (step = unidades que suma o quita cada clic; cada unidad cuenta como 1 para el mínimo) ===== */
const PRODUCTOS = [
  {id:'esquites',        name:'Esquite en Vaso',              field:'Cant_Esquites_Vaso',          step:5, unit:'piezas', desc:'Opciones de preparación: Limón / Crema y Queso / Crema, Mayo y Queso.'},
  {id:'elote_cocido',    name:'Elote Cocido en Palo',         field:'Cant_Elote_Cocido',           step:5, unit:'piezas', desc:'Elote tierno cocido al vapor, suave y tradicional.'},
  {id:'garbanzo',        name:'Garbanzo en Vaso',             field:'Cant_Garbanzo_Vaso',          step:5, unit:'piezas', desc:'Garbanzos cocidos calientitos servidos con chile y limón.'},
  {id:'tostielote',      name:'Tostielotes',                  field:'Cant_Tostielotes',            step:5, unit:'piezas', desc:'Bolsa de Tostitos preparada con elote caliente y aderezos.'},
  {id:'charola_elote',   name:'Charola Mediana de Elote',     field:'Cant_Charola_Mediana_Elote',  step:5, unit:'piezas', desc:'Charola mediana de elote para compartir.'},
  {id:'charola_verdura', name:'Charola de Elote con Verdura', field:'Cant_Charola_Elote_Verdura',  step:5, unit:'piezas', desc:'Elote con papa, chayote y garbanzo al vapor.'}
];
const itemCounts = {};

function renderProductos() {
  const grid = document.getElementById('products-grid');
  PRODUCTOS.forEach(p => {
    itemCounts[p.id] = 0;
    const d = document.createElement('div');
    d.className = 'product-item';
    d.innerHTML =
      `<div class="product-info"><h4>${p.name}</h4><p>${p.desc}</p></div>
       <div class="counter-control">
         <button type="button" class="btn-counter" data-id="${p.id}" data-dir="-1" aria-label="Quitar ${p.step} ${p.unit} de ${p.name}">-</button>
         <input type="number" id="${p.id}" name="${p.field}" class="counter-input" value="0" min="0" readonly aria-label="Cantidad de ${p.name}">
         <button type="button" class="btn-counter" data-id="${p.id}" data-dir="1" aria-label="Agregar ${p.step} ${p.unit} de ${p.name}">+</button>
         <span class="step-hint">de ${p.step} en ${p.step}</span>
       </div>`;
    grid.appendChild(d);
  });
  grid.addEventListener('click', e => {
    const b = e.target.closest('.btn-counter');
    if (b) adjustCount(b.dataset.id, Number(b.dataset.dir));
  });
}

function adjustCount(id, dir) {
  const p = PRODUCTOS.find(x => x.id === id);
  itemCounts[id] = Math.max(0, itemCounts[id] + dir * p.step);
  document.getElementById(id).value = itemCounts[id];
  updateTotals();
}

function updateTotals() {
  const total = PRODUCTOS.reduce((s, p) => s + itemCounts[p.id], 0);
  const msg = document.getElementById('status-message');
  const btn = document.getElementById('btn-submit');
  document.getElementById('hidden_total_pieces').value = total;
  document.getElementById('pieces-count').textContent = `${total} / 100 piezas`;
  document.getElementById('progress-fill').style.width = Math.min(total, 100) + '%';
  if (total >= 100) {
    msg.className = 'status-text ready';
    msg.innerHTML = `<i class="fa-solid fa-circle-check"></i> ¡Listo! Ya puedes enviar tu solicitud (${total} piezas). Agrega más si quieres.`;
    btn.disabled = false;
  } else if (total === 0) {
    msg.className = 'status-text';
    msg.innerHTML = `<i class="fa-solid fa-seedling"></i> Empieza a agregar productos para armar tu pedido (mínimo 100 piezas).`;
    btn.disabled = true;
  } else {
    msg.className = 'status-text';
    msg.innerHTML = `<i class="fa-solid fa-circle-chevron-up"></i> ¡Vas muy bien! Te faltan ${100 - total} piezas para poder enviar tu solicitud.`;
    btn.disabled = true;
  }
}

/* ===== GALERÍA: imágenes desde Google Drive =====
   1) En Drive: clic derecho en la imagen > Compartir > "Cualquier persona con el enlace" (Lector).
   2) Copia el enlace y pégalo en "drive". Para más fotos, agrega otra línea.
   3) Opcional: enlace de una carpeta completa en CARPETA_DRIVE para el botón "Ver más eventos". */
const CARPETA_DRIVE = "";
const GALERIA_EVENTOS = [
  {drive:"", titulo:"Montaje de la estación"},
  {drive:"", titulo:"Personal capacitado"},
  {drive:"", titulo:"Equipo uniformado"},
  {drive:"", titulo:"Presentación de esquites y elotes"}
];

function driveId(url) {
  const m = (url || "").match(/\/d\/([\w-]+)/) || (url || "").match(/[?&]id=([\w-]+)/);
  return m ? m[1] : null;
}

function itemVacio(titulo) {
  const d = document.createElement('div');
  d.className = 'gallery-item';
  d.innerHTML = '<div class="gallery-placeholder"><i class="fa-solid fa-image"></i><span>Foto próximamente</span></div>';
  const cap = document.createElement('div');
  cap.className = 'gallery-caption';
  cap.textContent = titulo;
  d.appendChild(cap);
  return d;
}

function renderGaleria() {
  const grid = document.getElementById('gallery-grid');
  GALERIA_EVENTOS.forEach(ev => {
    const id = driveId(ev.drive);
    if (!id) { grid.appendChild(itemVacio(ev.titulo)); return; }
    const a = document.createElement('a');
    a.className = 'gallery-item';
    a.href = `https://drive.google.com/file/d/${id}/view`;
    a.target = '_blank';
    a.rel = 'noopener';
    const img = document.createElement('img');
    img.src = `https://drive.google.com/thumbnail?id=${id}&sz=w1000`;
    img.alt = ev.titulo;
    img.loading = 'lazy';
    img.referrerPolicy = 'no-referrer';
    img.onerror = () => a.replaceWith(itemVacio(ev.titulo));
    const cap = document.createElement('div');
    cap.className = 'gallery-caption';
    cap.textContent = ev.titulo;
    a.append(img, cap);
    grid.appendChild(a);
  });
  if (CARPETA_DRIVE) {
    const more = document.getElementById('gallery-more');
    more.href = CARPETA_DRIVE;
    more.style.display = 'inline-block';
  }
}

/* ===== CARRUSEL HORIZONTAL ===== */
function initCarrusel() {
  const grid = document.getElementById('gallery-grid');
  const prev = document.getElementById('gallery-prev');
  const next = document.getElementById('gallery-next');
  const paso = () => grid.firstElementChild.offsetWidth + 19;
  const estado = () => {
    prev.disabled = grid.scrollLeft <= 4;
    next.disabled = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 4;
  };
  prev.addEventListener('click', () => grid.scrollBy({left: -paso(), behavior: 'smooth'}));
  next.addEventListener('click', () => grid.scrollBy({left: paso(), behavior: 'smooth'}));
  grid.addEventListener('scroll', estado, {passive: true});
  grid.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') next.click();
    if (e.key === 'ArrowLeft') prev.click();
  });
  window.addEventListener('resize', estado);
  estado();
}

/* ===== INICIO ===== */
renderProductos();
renderGaleria();
initCarrusel();
updateTotals();

// La fecha del evento no puede ser pasada
const hoy = new Date();
hoy.setMinutes(hoy.getMinutes() - hoy.getTimezoneOffset());
document.getElementById('fecha').min = hoy.toISOString().slice(0, 10);

// Al enviar, FormSubmit regresa a esta misma página con ?enviado=1
document.getElementById('next-url').value = location.origin + location.pathname + '?enviado=1#cotizador';
if (new URLSearchParams(location.search).get('enviado') === '1') {
  const ok = document.getElementById('form-success');
  ok.classList.add('show');
  ok.scrollIntoView({behavior:'smooth', block:'center'});
}
</script>
